# Vercel / local production configuration. Never enable demo mode in production.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SYNC_URL=/api/service
# Public Firebase Web SDK project configuration (not a password).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Server only. Add the verified learner email/UID mapping privately.
FIREBASE_PROJECT_ID=
APPS_SCRIPT_URL=
ACCOUNT_ROSTER_JSON={}
