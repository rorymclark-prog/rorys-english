{
  "name": "rorys-english",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first PWA for Rory's English students — homework + progress, study tools linked out.",
  "scripts": {
    "predev": "node scripts/gen-pwa.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-roster.mjs && node scripts/gen-pwa.mjs",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel --prod",
    "ui:rollback": "node scripts/ui-rollback.mjs rollback",
    "ui:restore": "node scripts/ui-rollback.mjs restore",
    "ui:rollbacks": "node scripts/ui-rollback.mjs list",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
