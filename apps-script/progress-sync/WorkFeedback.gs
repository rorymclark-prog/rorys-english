function workFeedbackAudit_(code){
 DOCUMENT_LEARNING_CACHE_=learningLatest_(code,'teacher').filter(function(r){return r[5]==='shared';});DOCUMENT_CHECKS_CACHE_=documentChecks_(code);
 var documents=documentRows_(code).filter(function(r){return !/^\[Document role: (review|task)\]$/m.test(r[10]||'');}).map(function(r){var d=documentPublic_(r,false,true),a=JSON.parse(r[6]||'null'),linked=documentRelatedReview_(code,r,true);return {id:r[0],title:r[1],type:d.workType,feedback:!!(d.hasConversationFeedback||a&&a.summary||linked&&linked.body.writing),detailed:!!(a&&(a.answerReview?.length||a.exerciseAnswers?.length||a.writing?.original)||linked&&linked.body.writing?.original),needsCheck:d.needsTeacherCheck};});
