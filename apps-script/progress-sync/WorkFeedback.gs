function refineConversationFeedback_(code,p,s){
 var existing=learningFind_(code,p.id),body=JSON.parse(existing[6]||'{}');if(s.role!=='teacher'||p.preview||existing[3]!=='speaking'||existing[7]!=='Student'||existing[5]!=='shared')throw new Error('Saved student conversation not found.');
 if(body.feedbackVersion===2&&body.plainAiFeedback)return {ok:true,record:learningPublic_(existing,'teacher')};
