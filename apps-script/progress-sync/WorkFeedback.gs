function workPractice_(code,source,state,p,s){
 if(s.role!=='student'||!state||!state.analysis||p.version!==state.version||!documentId_(p.attemptId)||!documentText_(p.answer,1200)||!p.answer.trim())throw new Error('Open the current practice and try an answer first.');
 var exercise=(state.analysis.exercises||[]).filter(function(e){return e.id===p.exerciseId;})[0];if(!exercise)throw new Error('Exercise not found.');
 var lock=LockService.getScriptLock();lock.waitLock(10000);try{
  var rows=documentPracticeRows_(code,source.key),prior=rows.filter(function(r){return r[0]===p.attemptId;})[0];if(prior){if(prior[2]!==p.version||prior[3]!==p.exerciseId||documentPracticeAnswer_(prior[5])!==p.answer.trim())throw new Error('Attempt identifier already used.');return {ok:true,received:true,attempt:documentPracticePublic_(prior)};}
  var today=new Date().toISOString().slice(0,10);if(rows.filter(function(r){return String(r[4]).slice(0,10)===today;}).length>=100)throw new Error('You have saved plenty of practice today. Come back tomorrow.');
  function normal(x){return String(x).toLowerCase().replace(/[.!?]+$/,'').replace(/\s+/g,' ').trim();}
  var closed=['gap','choice'].includes(exercise.type),result={status:closed?(exercise.accepted.some(function(x){return normal(x)===normal(p.answer);})?'correct':'try-again'):'compare',example:exercise.example,explanation:exercise.explanation},ss=studentSheet_(code),sh=ss.getSheetByName('Document practice');if(!sh){sh=ss.insertSheet('Document practice');sh.appendRow(['Id','Document','Review version','Exercise','Created','Answer JSON','Result JSON']);}var row=[p.attemptId,source.key,state.version,exercise.id,new Date().toISOString(),JSON.stringify(p.answer.trim()),JSON.stringify(result)];sh.appendRow(row);return {ok:true,received:true,attempt:documentPracticePublic_(row)};
 }finally{lock.releaseLock();}
