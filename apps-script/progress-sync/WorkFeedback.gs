// Automatic practice feedback for immutable typed submissions and learning replies.
// Originals and Rory's formal feedback columns remain untouched.
function workFeedbackRows_(code){var sh=studentSheet_(code).getSheetByName('Work feedback');return sh?sh.getDataRange().getValues().slice(1):[];}
function workFeedbackLatest_(code,key){var rows=workFeedbackRows_(code);for(var i=rows.length-1;i>=0;i--)if(rows[i][0]===key)return JSON.parse(rows[i][2]);return null;}
function workFeedbackSave_(code,key,state){var ss=studentSheet_(code),sh=ss.getSheetByName('Work feedback');if(!sh){sh=ss.insertSheet('Work feedback');sh.appendRow(['Source','Updated','Feedback JSON']);}sh.appendRow([key,new Date().toISOString(),JSON.stringify(state)]);}
function workFeedbackSource_(code,kind,id,teacher){
 if(!documentId_(id)||!['submission','reply'].includes(kind))throw new Error('Saved work not found.');
 var row,answers={},prompts={},title='Saved work';
 if(kind==='submission'){var sh=submissionSheet_(code,false),rows=sh?sh.getDataRange().getValues().slice(1):[];row=rows.filter(function(r){return r[0]===id;})[0];if(!row)throw new Error('Submission not found.');answers=JSON.parse(row[4]||'{}');prompts=JSON.parse(row[9]||'{}');title=row[8]||row[1];}
 else {row=learningRows_(code,true).filter(function(r){return r[0]===id;})[0];if(!row)throw new Error('Reply not found.');var target=learningFind_(code,row[1]);if(!teacher&&(target[5]!=='shared'||reviewHeld_(target[8])))throw new Error('Access denied');var b=JSON.parse(target[6]||'{}');answers={answer:row[3]};prompts={answer:b.lessonPractice?.writingPrompt||b.nextStep||b.summary||target[4]};title=target[4];}
 var text=[],links=[];Object.keys(answers).forEach(function(k){var raw=String(answers[k]||'');if(/^Practice rings · Link saved work\n/.test(raw))return;if(/^Practice rings · Writing\n/.test(raw))raw=raw.slice(raw.indexOf('My writing:\n')+12);if(/^Practice rings · Vocabulary\n/.test(raw))raw=raw.replace(/^Practice rings · Vocabulary\nWeek: [^\n]+\nUnit: [^\n]+\nLesson: [^\n]+\n/,'');var re=/\[Handwritten answer: ([A-Za-z0-9_-]{16,100})\]/g,m;while((m=re.exec(raw)))if(links.indexOf(m[1])<0){documentFind_(code,m[1]);links.push(m[1]);}var clean=raw.replace(re,'').trim();if(clean)text.push({id:k,prompt:String(prompts[k]||k),answer:clean});});
 return {key:kind+':'+id,id:id,kind:kind,title:title,items:text,documents:links};
}
function workFeedbackPublic_(code,source,state,teacher){
 var a=state&&state.analysis?JSON.parse(JSON.stringify(state.analysis)):null,namespace=source.key,rows=documentPracticeRows_(code,namespace).map(documentPracticePublic_);
 if(a&&!teacher){delete a.model;delete a.readingModel;delete a.teacherNotes;a.exercises=(a.exercises||[]).map(function(e){return {id:e.id,type:e.type,prompt:e.prompt,options:e.options,focus:e.focus};});}
 var result={ok:true,analysis:a,pending:!!(state&&state.lease&&Date.now()-state.started<360000),error:state&&state.error||'',version:state&&state.version||'',attempts:rows,documents:source.documents,hasTyped:source.items.length>0};if(teacher)result.needsTeacherCheck=!!a&&!documentCheckedAt_(source.key,state.version);return result;
