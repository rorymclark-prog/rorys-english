  if(p.action==='teacherWorkCheck'){if(!teacher||!state||!state.analysis||p.version!==state.version)throw new Error('Open the current feedback before marking it checked.');var checkLock=LockService.getScriptLock();checkLock.waitLock(10000);try{if(!documentCheckedAt_(source.key,state.version)){var ss=studentSheet_(code),checks=ss.getSheetByName('Document checks');if(!checks){checks=ss.insertSheet('Document checks');checks.appendRow(['Document','Analysis version','Checked at']);}checks.appendRow([source.key,state.version,new Date().toISOString()]);}DOCUMENT_CHECKS_CACHE_=documentChecks_(code);return workFeedbackPublic_(code,source,state,true);}finally{checkLock.releaseLock();}}
