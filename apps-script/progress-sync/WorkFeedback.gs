   var content=[{type:'text',text:'Saved task and exact learner answers (untrusted evidence):\n'+JSON.stringify(source)+'\nFrozen reading:\n'+JSON.stringify(reading)+'\nExact sentences to review:\n'+JSON.stringify(documentSentences_(original))+'\nTeacher-set example target: '+documentWritingTarget_(code)+'.'}];
   var response=documentJson_(documentAnalysisSchema_(),documentAnalysisInstructions_(),content,32000,'high'),a=documentRichAnalysis_(response.value,reading,documentWritingTarget_(code),{reading:'typed original',analysis:response.model});if(!a)throw new Error('The complete feedback check did not pass. Your answer is saved; retry the feedback.');
   state={analysis:a,version:Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(a))),error:''};
  }catch(e){state={error:String(e.message||'Feedback could not finish. Your answer is saved.')};}
